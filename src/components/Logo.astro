---
import { t, link, asset, type Lang } from '../i18n/utils';
interface Props { lang: Lang; light?: boolean }
const { lang, light = false } = Astro.props;
const c = t(lang).company;
---
<a href={link(lang)} class="flex shrink-0 items-center" aria-label={c.name}>
  <img
    src={asset(light ? '/brand/logo-horizontal-white.svg' : '/brand/logo-horizontal.svg')}
    alt={c.name}
    width="190"
    height="44"
    class="h-12 w-auto sm:h-14"
  />
</a>
