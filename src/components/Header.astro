---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact, whatsappLink } from '../data/site';
import { t, link, routeOf, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';

const route = routeOf(Astro.url.pathname);
const isActive = (r: string) => (r === '/' ? route === '/' : route.startsWith(r));

const nav = [
  { label: d.nav.home, route: '/' },
  {
    label: d.nav.about,
    route: '/about',
    children: [
      { label: d.nav.overview, route: '/about' },
      { label: d.nav.leadership, route: '/leadership' },
      { label: d.nav.licences, route: '/licences' },
      { label: d.nav.hse, route: '/hse' },
    ],
  },
  { label: d.nav.services, route: '/services' },
  { label: d.nav.sectors, route: '/sectors' },
  { label: d.nav.projects, route: '/projects' },
  { label: d.nav.careers, route: '/careers' },
  { label: d.nav.contact, route: '/contact' },
];
const switchHref = link(other, route);
---
<div class="no-print hidden bg-navy-950 text-xs text-white/70 md:block">
  <div class="container-x flex h-9 items-center justify-between">
    <div class="flex items-center gap-6">
      <a href={contact.phoneHref} class="flex items-center gap-1.5 hover:text-white"><Icon name="phone" class="h-3.5 w-3.5" /><span dir="ltr">{contact.phone}</span></a>
      <a href={`mailto:${contact.email}`} class="flex items-center gap-1.5 hover:text-white"><Icon name="mail" class="h-3.5 w-3.5" />{contact.email}</a>
    </div>
    <div class="flex items-center gap-1.5"><Icon name="clock" class="h-3.5 w-3.5 text-gold-400" />{d.common.emergency}</div>
  </div>
</div>

<header class="no-print sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-x flex h-18 items-center justify-between gap-6 py-3">
    <Logo lang={lang} />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {nav.map((item) =>
        item.children ? (
          <div class="group relative">
            <a href={link(lang, item.route)} class:list={['flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium', item.children.some((c) => isActive(c.route)) ? 'text-teal-600' : 'text-navy-900 hover:text-teal-600']}>
              {item.label}
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.2 7.2a.75.75 0 0 1 1.06 0L10 10.94l3.74-3.74a.75.75 0 1 1 1.06 1.06l-4.27 4.27a.75.75 0 0 1-1.06 0L5.2 8.26a.75.75 0 0 1 0-1.06z" /></svg>
            </a>
            <div class="invisible absolute start-0 top-full w-60 translate-y-1 rounded-lg border border-line bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              {item.children.map((c) => (
                <a href={link(lang, c.route)} class="block rounded-md px-3 py-2 text-sm text-navy-900 hover:bg-mist hover:text-teal-600">{c.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link(lang, item.route)} class:list={['rounded-md px-3 py-2 text-sm font-medium', isActive(item.route) ? 'text-teal-600' : 'text-navy-900 hover:text-teal-600']}>{item.label}</a>
        )
      )}
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a href={switchHref} hreflang={other} lang={other} class="rounded-md px-3 py-2 text-sm font-semibold text-navy-900 hover:text-teal-600">{d.meta.switchLabel}</a>
      <a href={link(lang, '/contact#quote')} class="btn btn-dark">{d.common.requestQuote}</a>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <a href={switchHref} hreflang={other} lang={other} class="rounded-md px-2 py-2 text-sm font-semibold text-navy-900">{d.meta.switchLabel}</a>
      <button id="menu-btn" class="rounded-md p-2 text-navy-900" aria-label={d.common.menuOpen} aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Mobile">
      {nav.flatMap((item) => [item, ...(item.children?.slice(1) ?? [])]).map((item) => (
        <a href={link(lang, item.route)} class:list={['rounded-md px-2 py-2.5 text-sm font-medium', isActive(item.route) ? 'text-teal-600' : 'text-navy-900']}>{item.label}</a>
      ))}
      <div class="mt-3 grid grid-cols-2 gap-2">
        <a href={link(lang, '/contact#quote')} class="btn btn-dark">{d.common.requestQuote}</a>
        <a href={whatsappLink(d.common.waDefault)} target="_blank" rel="noopener" class="btn btn-outline">{d.common.whatsapp}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
