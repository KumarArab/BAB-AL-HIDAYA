---
interface Props { eyebrow?: string; title: string; subtitle?: string; crumbs?: { label: string; href?: string }[] }
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="pattern-grid absolute inset-0" aria-hidden="true"></div>
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-teal-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-16 sm:py-20">
    {crumbs.length > 0 && (
      <nav class="mb-4 text-xs text-white/60" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        {crumbs.map((c) => (<><span class="mx-2">/</span>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white/90">{c.label}</span>}</>))}
      </nav>
    )}
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-3xl font-extrabold text-white sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-white/75">{subtitle}</p>}
  </div>
</section>
