---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, statValues, registration, certificationCodes, whatsappLink } from '../data/site';
import { getServices } from '../data/services';
import { t, link, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const services = getServices(lang);
const reasonIcons = ['shield', 'clock', 'users', 'doc'] as const;
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy-950 text-white">
    <img src={asset('/images/hero-dubai-night.jpg')} alt={h.photoAlt.hero} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40 rtl:bg-gradient-to-l" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-navy-950/80 to-transparent" aria-hidden="true"></div>

    <div class="container-x relative grid items-center gap-12 py-20 lg:grid-cols-12 lg:py-32">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-medium text-white/90 backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span> {h.since(company.founded)}
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.1] text-white sm:text-5xl lg:text-6xl">
          {h.heroA} <span class="text-gold-400">{h.heroB}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/80">{d.company.shortPitch}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={link(lang, '/contact#quote')} class="btn btn-primary">{h.heroCta} <Icon name="arrow" class="h-4 w-4" /></a>
          <a href={whatsappLink(d.common.waDefault)} target="_blank" rel="noopener" class="btn btn-ghost bg-white/5 backdrop-blur"><Icon name="whatsapp" class="h-4 w-4" /> {d.common.chatWhatsapp}</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/80">
          {h.heroChecks.map((c) => <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-teal-500" />{c}</li>)}
        </ul>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-white/15 bg-navy-950/60 p-6 shadow-2xl backdrop-blur-md sm:p-8">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">{h.credTitle}</p>
            <Icon name="shield" class="h-6 w-6 text-teal-500" />
          </div>
          <dl class="mt-6 divide-y divide-white/10 text-sm">
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">{h.credLegal}</dt><dd class="text-end font-medium">{d.registration.legalFormShort}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">{h.credLicence}</dt><dd class="text-end font-medium">{h.licenceNo(registration.tradeLicenceNo)}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">{h.credIssued}</dt><dd class="text-end font-medium">{d.registration.issuingShort}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">{h.credTrn}</dt><dd class="text-end font-medium">{registration.vatTrn}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">{h.credApprovals}</dt><dd class="text-end font-medium">{h.credApprovalsVal}</dd></div>
          </dl>
          <a href={link(lang, '/licences')} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-400 hover:text-gold-50">{h.credLink} <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="relative z-10 -mt-px bg-white shadow-sm">
    <div class="container-x grid grid-cols-2 py-10 md:grid-cols-4 md:divide-x md:divide-line rtl:md:divide-x-reverse">
      {statValues.map((v, i) => (
        <div class="px-4 py-4 text-center">
          <p class="font-display text-4xl font-extrabold text-navy-900 sm:text-5xl" dir="ltr">{v}</p>
          <p class="mt-1 text-sm text-muted">{d.stats[i]}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-mist">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHead eyebrow={h.servicesEyebrow} title={h.servicesTitle} lead={h.servicesLead} />
        <a href={link(lang, '/services')} class="btn btn-outline shrink-0">{d.common.allServices}</a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <a href={link(lang, `/services/${s.slug}`)} class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <div class="relative h-48 overflow-hidden">
              <img src={asset(s.image)} alt={s.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 to-transparent"></div>
              <span class="absolute bottom-4 start-4 flex h-11 w-11 items-center justify-center rounded-lg bg-white text-teal-600 shadow"><Icon name={s.icon} /></span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-lg font-bold">{s.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{s.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-teal-600">{d.common.learnMore} <Icon name="arrow" class="h-4 w-4" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section overflow-hidden">
    <div class="container-x grid gap-16 lg:grid-cols-2 lg:items-center">
      <div class="relative">
        <div class="grid grid-cols-5 gap-4">
          <img src={asset('/images/cleaning-team.jpg')} alt={h.photoAlt.team} loading="lazy" class="col-span-3 h-80 w-full rounded-2xl object-cover shadow-lg sm:h-[26rem]" />
          <div class="col-span-2 flex flex-col gap-4 pt-12">
            <img src={asset('/images/technician-ppe.jpg')} alt={h.photoAlt.tech} loading="lazy" class="h-44 w-full rounded-2xl object-cover shadow-lg sm:h-56" />
            <div class="rounded-2xl bg-navy-900 p-5 text-white shadow-lg">
              <p class="font-display text-3xl font-extrabold text-gold-400" dir="ltr">{statValues[1]}</p>
              <p class="mt-1 text-xs text-white/70">{d.stats[1]}</p>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-6 start-6 hidden max-w-xs items-center gap-3 rounded-xl border border-line bg-white p-4 shadow-xl sm:flex">
          <span class="icon-tile shrink-0"><Icon name="users" /></span>
          <div><p class="text-sm font-bold text-navy-900">{h.badgeTitle}</p><p class="text-xs text-muted">{h.badgeText}</p></div>
        </div>
      </div>
      <div>
        <SectionHead eyebrow={h.whyEyebrow} title={h.whyTitle} lead={h.whyLead} />
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {h.reasons.map((r, i) => (
            <div>
              <span class="icon-tile"><Icon name={reasonIcons[i]} /></span>
              <h3 class="mt-4 font-bold">{r.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{r.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AMC PROCESS -->
  <section class="section relative overflow-hidden bg-navy-900 text-white">
    <div class="pattern-grid absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">{h.amcEyebrow}</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{h.amcTitle}</h2>
          <p class="mt-4 text-lg text-white/70">{h.amcLead}</p>
        </div>
        <img src={asset('/images/contract-handshake.jpg')} alt={h.photoAlt.contract} loading="lazy" class="h-56 w-full rounded-2xl object-cover opacity-90 shadow-2xl lg:h-64" />
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {h.steps.map((s, i) => (
          <li class="rounded-xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur">
            <span class="font-display text-3xl font-extrabold text-gold-400">0{i + 1}</span>
            <h3 class="mt-3 font-bold text-white">{s.title}</h3>
            <p class="mt-2 text-sm text-white/65">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 grid gap-4 rounded-xl bg-gradient-to-r from-teal-600 to-teal-500 p-6 sm:grid-cols-3">
        {h.sla.map((s) => <div><p class="text-sm text-white/75">{s.label}</p><p class="font-display text-2xl font-bold text-white">{s.value}</p></div>)}
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow={h.sectorsEyebrow} title={h.sectorsTitle} center />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {d.sectors.map((s, i) => (
          <div class="group rounded-xl border border-line p-5 transition hover:border-teal-500 hover:shadow-md">
            <p class="font-display text-sm font-bold text-gold-500">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COVERAGE BAND -->
  <section class="relative overflow-hidden">
    <img src={asset('/images/dubai-marina.jpg')} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-navy-950/75" aria-hidden="true"></div>
    <div class="container-x relative py-20 text-center text-white sm:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">{h.coverageEyebrow}</p>
      <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-bold text-white sm:text-4xl">{h.coverageTitle}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">{h.coverageText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {h.emirates.map((e) => <span class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 py-2 text-sm font-semibold backdrop-blur"><Icon name="pin" class="h-4 w-4 text-gold-400" />{e}</span>)}
      </div>
    </div>
  </section>

  <!-- COMPLIANCE STRIP -->
  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow={h.complianceEyebrow} title={h.complianceTitle} lead={h.complianceLead} center />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {certificationCodes.map((code, i) => (
          <div class="card flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-gold-500 font-display text-xs font-extrabold text-navy-900">ISO</div>
            <div><p class="font-display text-lg font-extrabold text-navy-900" dir="ltr">{code}</p><p class="text-sm text-muted">{d.certifications[i]}</p></div>
          </div>
        ))}
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {d.approvals.map((a) => (
          <div class="flex gap-3 rounded-xl border border-line bg-white p-5">
            <Icon name="shield" class="h-6 w-6 shrink-0 text-teal-600" />
            <div><p class="text-sm font-bold text-navy-900">{a.title}</p><p class="mt-1 text-xs text-muted">{a.detail}</p></div>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center"><a href={link(lang, '/licences')} class="btn btn-dark">{d.nav.licences}</a></div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow={h.testimonialsEyebrow} title={h.testimonialsTitle} center />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {d.testimonials.map((tm) => (
          <figure class="card relative flex flex-col">
            <span class="absolute end-6 top-4 font-display text-6xl leading-none text-teal-50" aria-hidden="true">”</span>
            <div class="flex gap-0.5 text-gold-500">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}</div>
            <blockquote class="relative mt-4 flex-1 text-sm leading-relaxed text-ink">“{tm.quote}”</blockquote>
            <figcaption class="mt-5 border-t border-line pt-4 text-sm"><span class="font-semibold text-navy-900">{tm.author}</span><br /><span class="text-muted">{tm.org}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
