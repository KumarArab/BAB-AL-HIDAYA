---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { contact, registration, approvalRefs, certificationCodes } from '../data/site';
import { t, link, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.licencesPage;
const r = d.registration;
const c = d.common.comma;

const rows: [string, string, boolean?][] = [
  [p.rows.name, d.company.legalName],
  [p.rows.nameAlt, d.company.legalNameAlt, true],
  [p.rows.form, r.legalForm],
  [p.rows.licence, registration.tradeLicenceNo],
  [p.rows.type, r.licenceType],
  [p.rows.authority, r.issuingAuthority],
  [p.rows.issued, r.licenceIssued],
  [p.rows.expiry, r.licenceExpiry],
  [p.rows.trn, registration.vatTrn],
  [p.rows.chamber, r.chamber(registration.chamberNo)],
  [p.rows.office, `${d.address.line1}${c}${d.address.line2}${c}${d.address.city}${c}${d.address.short}`],
  [p.rows.tenancy, r.ejari],
];
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.heading} subtitle={p.subtitle} image="/images/contract-handshake.jpg" crumbs={[{ label: d.nav.about, route: '/about' }, { label: p.title }]} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHead eyebrow={p.regEyebrow} title={p.regTitle} />
        <dl class="mt-8 overflow-hidden rounded-xl border border-line">
          {rows.map(([k, v, other], i) => (
            <div class:list={['grid gap-1 px-5 py-4 sm:grid-cols-5 sm:gap-4', i % 2 === 0 ? 'bg-mist' : 'bg-white']}>
              <dt class="text-sm font-medium text-muted sm:col-span-2">{k}</dt>
              <dd class="text-sm font-semibold text-navy-900 sm:col-span-3" dir={other ? (lang === 'ar' ? 'ltr' : 'rtl') : undefined}>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-xl bg-navy-900 p-6 text-white shadow-xl">
          <h3 class="font-bold text-white">{p.activitiesTitle}</h3>
          <p class="mt-1 text-xs text-white/60">{p.activitiesSub(registration.tradeLicenceNo)}</p>
          <ul class="mt-5 space-y-3">
            {r.activities.map((act) => (
              <li class="flex gap-2 text-sm"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" />{act}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow={p.approvalsEyebrow} title={p.approvalsTitle} />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {d.approvals.map((a, i) => (
          <div class="card">
            <span class="icon-tile"><Icon name="shield" /></span>
            <h3 class="mt-4 font-bold">{a.title}</h3>
            <p class="mt-2 text-sm text-muted">{a.detail}</p>
            {approvalRefs[i] && <p class="mt-4 text-xs font-semibold text-teal-600">{d.common.ref} <span dir="ltr">{approvalRefs[i]}</span></p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHead eyebrow={p.certEyebrow} title={p.certTitle} lead={p.certLead} />
        <div class="mt-8 space-y-4">
          {certificationCodes.map((code, i) => (
            <div class="flex items-center gap-4 rounded-xl border border-line p-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-gold-500 font-display text-xs font-extrabold text-navy-900">ISO</div>
              <div><p class="font-bold text-navy-900" dir="ltr">{code}</p><p class="text-sm text-muted">{d.certifications[i]}</p></div>
            </div>
          ))}
        </div>
      </div>
      <div>
        <SectionHead eyebrow={p.insEyebrow} title={p.insTitle} lead={p.insLead} />
        <div class="mt-8 overflow-hidden rounded-xl border border-line">
          {d.insurance.map((ins, i) => (
            <div class:list={['flex flex-col justify-between gap-1 px-5 py-4 sm:flex-row', i % 2 === 0 ? 'bg-mist' : 'bg-white']}>
              <span class="text-sm font-semibold text-navy-900">{ins.type}</span>
              <span class="text-sm text-muted">{ins.cover}</span>
            </div>
          ))}
        </div>
        <p class="mt-4 text-sm text-muted">{p.wps}</p>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow={p.ddEyebrow} title={p.ddTitle} lead={p.ddLead} />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {p.docs.map((doc) => (
          <div class="flex items-center gap-3 rounded-lg border border-line bg-white p-4 text-sm font-medium text-navy-900"><Icon name="doc" class="h-5 w-5 shrink-0 text-teal-600" />{doc}</div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${contact.email}?subject=${encodeURIComponent(p.docSubject)}`} class="btn btn-dark">{p.requestDocs}</a>
        <a href={link(lang, '/company-profile')} class="btn btn-outline">{p.viewProfile}</a>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
