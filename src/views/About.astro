---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { statValues } from '../data/site';
import { t, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
---
<Base lang={lang} title={a.title} description={d.company.shortPitch}>
  <PageHero lang={lang} eyebrow={a.eyebrow} title={a.heading} subtitle={a.subtitle} image="/images/dubai-marina.jpg" crumbs={[{ label: d.nav.about }]} />

  <section class="section">
    <div class="container-x grid gap-16 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHead eyebrow={a.whoEyebrow} title={a.whoTitle} />
        <div class="mt-6 space-y-4 leading-relaxed text-muted">
          <p>{a.p1(d.company.legalName)}</p>
          <p>{a.p2}</p>
          <p>{a.p3}</p>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {statValues.map((v, i) => (
            <div class="rounded-xl bg-mist p-4 text-center">
              <p class="font-display text-2xl font-extrabold text-navy-900" dir="ltr">{v}</p>
              <p class="mt-1 text-xs text-muted">{d.stats[i]}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="relative">
        <img src={asset('/images/cleaning-team.jpg')} alt={d.home.photoAlt.team} loading="lazy" class="h-[28rem] w-full rounded-2xl object-cover shadow-xl" />
        <div class="absolute -bottom-6 end-6 rounded-xl bg-gold-500 px-6 py-4 text-navy-950 shadow-xl">
          <p class="font-display text-3xl font-extrabold" dir="ltr">{statValues[0]}</p>
          <p class="text-xs font-semibold">{d.stats[0]}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-2">
      <div class="card border-t-4 border-t-teal-600 p-8">
        <span class="icon-tile"><Icon name="star" /></span>
        <h3 class="mt-5 text-xl font-bold">{a.vision}</h3>
        <p class="mt-3 text-muted">{a.visionText}</p>
      </div>
      <div class="card border-t-4 border-t-gold-500 p-8">
        <span class="icon-tile"><Icon name="check" /></span>
        <h3 class="mt-5 text-xl font-bold">{a.mission}</h3>
        <p class="mt-3 text-muted">{a.missionText}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow={a.valuesEyebrow} title={a.valuesTitle} center />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {d.values.map((v) => (
          <div class="rounded-xl border-t-4 border-gold-500 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold">{v.title}</h3>
            <p class="mt-2 text-sm text-muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHead eyebrow={a.journeyEyebrow} title={a.journeyTitle} />
        <img src={asset('/images/dubai-aerial.jpg')} alt="" loading="lazy" class="mt-8 hidden h-80 w-full rounded-2xl object-cover shadow-lg lg:block" />
      </div>
      <ol class="relative border-s-2 border-line ps-8">
        {a.milestones.map((m) => (
          <li class="relative mb-10 last:mb-0">
            <span class="absolute -start-[41px] top-1 h-4 w-4 rounded-full border-4 border-mist bg-teal-600"></span>
            <p class="font-display text-lg font-extrabold text-gold-500">{m.year}</p>
            <p class="mt-1 text-muted">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
