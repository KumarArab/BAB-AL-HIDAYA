---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getServices } from '../data/services';
import { t, link, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.servicesPage;
const services = getServices(lang);
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.heading} subtitle={p.subtitle} image="/images/electrician.jpg" crumbs={[{ label: p.title }]} />

  <section class="section">
    <div class="container-x space-y-10">
      {services.map((s, i) => (
        <article class="grid overflow-hidden rounded-2xl border border-line bg-white shadow-sm lg:grid-cols-12">
          <div class:list={['relative min-h-64 lg:col-span-5', i % 2 === 1 && 'lg:order-2']}>
            <img src={asset(s.image)} alt={s.title} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            <span class="absolute start-5 top-5 rounded-full bg-navy-950/80 px-3 py-1 font-display text-sm font-bold text-gold-400 backdrop-blur">0{i + 1}</span>
          </div>
          <div class="p-8 lg:col-span-7 lg:p-10">
            <span class="icon-tile"><Icon name={s.icon} /></span>
            <h2 class="mt-5 text-2xl font-bold">{s.title}</h2>
            <p class="mt-3 text-muted">{s.intro}</p>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {s.items.map((item) => (
                <li class="flex gap-2 text-sm"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{item}</li>
              ))}
            </ul>
            <a href={link(lang, `/services/${s.slug}`)} class="btn btn-outline mt-8">{d.common.viewDetails} <Icon name="arrow" class="h-4 w-4" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
