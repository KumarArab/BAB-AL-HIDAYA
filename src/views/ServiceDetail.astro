---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getServices } from '../data/services';
import { contact, whatsappLink } from '../data/site';
import { t, link, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const d = t(lang);
const p = d.servicesPage;
const services = getServices(lang);
const service = services.find((s) => s.slug === slug)!;
const others = services.filter((s) => s.slug !== slug);
---
<Base lang={lang} title={service.title} description={service.summary}>
  <PageHero lang={lang} eyebrow={p.serviceEyebrow} title={service.title} subtitle={service.summary} image={service.image} crumbs={[{ label: p.title, route: '/services' }, { label: service.title }]} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <img src={asset(service.image)} alt={service.title} class="h-72 w-full rounded-2xl object-cover shadow-lg sm:h-96" />
        <p class="mt-10 text-lg leading-relaxed text-ink">{service.intro}</p>
        <h2 class="mt-10 text-2xl font-bold">{p.included}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {service.items.map((item) => (
            <li class="flex gap-3 rounded-lg border border-line p-4 text-sm"><Icon name="check" class="h-5 w-5 shrink-0 text-teal-600" />{item}</li>
          ))}
        </ul>
        <h2 class="mt-10 text-2xl font-bold">{p.why}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {service.benefits.map((b) => (
            <li class="rounded-lg border-s-4 border-teal-600 bg-teal-50 p-4 text-sm font-semibold text-navy-900">{b}</li>
          ))}
        </ul>
      </div>

      <aside class="space-y-6 lg:col-span-4">
        <div class="sticky top-28 space-y-6">
          <div class="rounded-xl bg-navy-900 p-6 text-white shadow-xl">
            <h3 class="text-lg font-bold text-white">{p.quoteTitle}</h3>
            <p class="mt-2 text-sm text-white/70">{p.quoteText}</p>
            <a href={link(lang, '/contact#quote')} class="btn btn-primary mt-5 w-full">{d.common.requestQuote}</a>
            <a href={whatsappLink(d.common.waService(service.title))} target="_blank" rel="noopener" class="btn btn-ghost mt-3 w-full"><Icon name="whatsapp" class="h-4 w-4" /> {d.common.whatsapp}</a>
            <a href={contact.phoneHref} class="mt-4 flex items-center justify-center gap-2 text-sm text-white/70 hover:text-white"><Icon name="phone" class="h-4 w-4" /><span dir="ltr">{contact.phone}</span></a>
          </div>
          <div class="rounded-xl border border-line p-6">
            <h3 class="font-bold">{p.others}</h3>
            <ul class="mt-4 space-y-3 text-sm">
              {others.map((s) => (
                <li><a href={link(lang, `/services/${s.slug}`)} class="flex items-center gap-3 text-muted hover:text-teal-600">
                  <img src={asset(s.image)} alt="" loading="lazy" class="h-10 w-10 shrink-0 rounded-md object-cover" />
                  <span class="flex-1">{s.title}</span><Icon name="arrow" class="h-4 w-4" />
                </a></li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
