---
import Base from '../layouts/Base.astro';
import { t, link, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<Base lang={lang} title={d.common.page}>
  <section class="section">
    <div class="container-x text-center">
      <p class="font-display text-6xl font-extrabold text-gold-500">404</p>
      <h1 class="mt-4 text-3xl font-bold">{d.common.notFoundTitle}</h1>
      <p class="mt-3 text-muted">{d.common.notFoundText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={link(lang)} class="btn btn-dark">{d.nav.home}</a>
        <a href={link(lang, '/services')} class="btn btn-outline">{d.nav.services}</a>
        <a href={link(lang, '/contact')} class="btn btn-outline">{d.nav.contact}</a>
      </div>
    </div>
  </section>
</Base>
