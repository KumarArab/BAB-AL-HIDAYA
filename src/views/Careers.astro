---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';
import { t, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.careersPage;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.heading} subtitle={p.subtitle} image="/images/team-walking.jpg" crumbs={[{ label: d.nav.careers }]} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHead eyebrow={p.whyEyebrow} title={p.whyTitle} />
        <ul class="mt-8 space-y-3">
          {p.perks.map((pk) => <li class="flex gap-3 text-sm"><Icon name="check" class="h-5 w-5 shrink-0 text-teal-600" />{pk}</li>)}
        </ul>
        <img src={asset('/images/cleaning-team.jpg')} alt={d.home.photoAlt.team} loading="lazy" class="mt-10 h-64 w-full rounded-2xl object-cover shadow-lg" />
      </div>
      <div class="lg:col-span-7">
        <h2 class="text-2xl font-bold">{p.openingsTitle}</h2>
        <div class="mt-6 space-y-4">
          {p.openings.map((o) => (
            <div class="card flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <h3 class="font-bold">{o.title}</h3>
                <p class="mt-1 text-xs font-semibold text-teal-600">{o.type} · {o.location}</p>
                <p class="mt-2 text-sm text-muted">{o.req}</p>
              </div>
              <a href={`mailto:${contact.careersEmail}?subject=${encodeURIComponent(p.applySubject(o.title))}`} class="btn btn-outline shrink-0">{p.apply}</a>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-muted">{p.sendCv} <a href={`mailto:${contact.careersEmail}`} class="font-semibold text-teal-600">{contact.careersEmail}</a>. {p.noFees}</p>
      </div>
    </div>
  </section>
</Base>
