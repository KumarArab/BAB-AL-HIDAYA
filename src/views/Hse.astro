---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { certificationCodes, hseKpiValues } from '../data/site';
import { t, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.hsePage;
const icons = ['hardhat', 'star', 'leaf', 'users'] as const;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.heading} subtitle={p.subtitle} image="/images/technician-ppe.jpg" crumbs={[{ label: d.nav.about, route: '/about' }, { label: p.title }]} />

  <section class="border-b border-line">
    <div class="container-x grid grid-cols-2 py-10 md:grid-cols-4">
      {hseKpiValues.map((v, i) => (
        <div class="p-4 text-center"><p class="font-display text-4xl font-extrabold text-teal-600" dir="ltr">{v}</p><p class="mt-1 text-sm text-muted">{p.kpis[i]}</p></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <SectionHead eyebrow={p.policyEyebrow} title={p.policyTitle} lead={p.policyLead} />
        <img src={asset('/images/technician-ppe.jpg')} alt={d.home.photoAlt.tech} loading="lazy" class="h-72 w-full rounded-2xl object-cover shadow-lg" />
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {p.pillars.map((pl, i) => (
          <div class="card p-8">
            <span class="icon-tile"><Icon name={icons[i]} /></span>
            <h3 class="mt-5 text-xl font-bold">{pl.title}</h3>
            <ul class="mt-4 space-y-2">
              {pl.points.map((pt) => <li class="flex gap-2 text-sm text-muted"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{pt}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {certificationCodes.map((code, i) => (
        <div class="card text-center"><p class="font-display text-xl font-extrabold" dir="ltr">{code}</p><p class="mt-1 text-sm text-muted">{d.certifications[i]}</p></div>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
