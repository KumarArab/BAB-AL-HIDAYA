---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, asset, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.projectsPage;
// Illustrative stock photos; replace with real project photos when available.
const images = ['/images/dubai-marina.jpg', '/images/office.jpg', '/images/dubai-aerial.jpg', '/images/cleaning-service.jpg', '/images/electrician.jpg', '/images/team-walking.jpg'];
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.heading} subtitle={p.subtitle} image="/images/dubai-marina.jpg" crumbs={[{ label: d.nav.projects }]} />
  <section class="section">
    <div class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {d.projects.map((pr, i) => (
        <article class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition hover:shadow-xl">
          <div class="relative h-52 overflow-hidden">
            <img src={asset(images[i])} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute end-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-navy-900 shadow">{pr.duration}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-lg font-bold">{pr.title}</h2>
            <p class="mt-1 flex items-center gap-1 text-sm text-teal-600"><Icon name="pin" class="h-4 w-4" />{pr.location}</p>
            <p class="mt-3 text-sm text-muted">{pr.scope}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {d.testimonials.map((tm) => (
        <figure class="card">
          <div class="flex gap-0.5 text-gold-500">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}</div>
          <blockquote class="mt-3 text-sm leading-relaxed">“{tm.quote}”</blockquote>
          <figcaption class="mt-4 text-sm"><span class="font-semibold text-navy-900">{tm.author}</span>{d.common.comma}<span class="text-muted">{tm.org}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
