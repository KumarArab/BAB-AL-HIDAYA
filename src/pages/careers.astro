---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';

const perks = ['Salary paid on time through WPS', 'UAE residence visa & medical insurance', 'Accommodation and transport', 'Paid annual leave and air ticket', 'Trade and safety training', 'Clear path to supervisor roles'];
const openings = [
  { title: 'HVAC Technician', type: 'Full-time', location: 'Dubai', req: '3+ years UAE experience in split and ducted systems.' },
  { title: 'Electrician', type: 'Full-time', location: 'Dubai', req: 'Trade certificate; experience in building maintenance.' },
  { title: 'Cleaning Supervisor', type: 'Full-time', location: 'Dubai / Sharjah', req: '2+ years supervising commercial cleaning teams.' },
  { title: 'Office Cleaner (Male / Female)', type: 'Full-time', location: 'Dubai', req: 'Previous cleaning experience preferred; training provided.' },
];
---
<Base title="Careers" description="Join Bab Al Hidaya: jobs for technicians, cleaners and supervisors in Dubai.">
  <PageHero eyebrow="Careers" title="Build your career with us" subtitle="We invest in our people, because our service is only as good as the team delivering it." crumbs={[{ label: 'Careers' }]} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHead eyebrow="Why work here" title="What we offer" />
        <ul class="mt-8 space-y-3">
          {perks.map((p) => <li class="flex gap-3 text-sm"><Icon name="check" class="h-5 w-5 shrink-0 text-teal-600" />{p}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-7">
        <h2 class="text-2xl font-bold">Current openings</h2>
        <div class="mt-6 space-y-4">
          {openings.map((o) => (
            <div class="card flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <h3 class="font-bold">{o.title}</h3>
                <p class="mt-1 text-xs font-semibold text-teal-600">{o.type} · {o.location}</p>
                <p class="mt-2 text-sm text-muted">{o.req}</p>
              </div>
              <a href={`mailto:${contact.careersEmail}?subject=${encodeURIComponent('Application: ' + o.title)}`} class="btn btn-outline shrink-0">Apply</a>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-muted">Send your CV to <a href={`mailto:${contact.careersEmail}`} class="font-semibold text-teal-600">{contact.careersEmail}</a>. We never charge candidates any recruitment fees.</p>
      </div>
    </div>
  </section>
</Base>
