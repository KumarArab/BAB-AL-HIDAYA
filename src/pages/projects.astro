---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects, testimonials } from '../data/site';
---
<Base title="Projects" description="Selected building maintenance and cleaning engagements by Bab Al Hidaya across Dubai and the Northern Emirates.">
  <PageHero eyebrow="Projects" title="Selected engagements" subtitle="Client names are kept confidential. References are available to qualified enquiries on request." crumbs={[{ label: 'Projects' }]} />
  <section class="section">
    <div class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <article class="card flex flex-col">
          <div class="flex items-center justify-between">
            <span class="icon-tile"><Icon name="building" /></span>
            <span class="rounded-full bg-gold-50 px-3 py-1 text-xs font-semibold text-navy-900">{p.duration}</span>
          </div>
          <h2 class="mt-5 text-lg font-bold">{p.title}</h2>
          <p class="mt-1 flex items-center gap-1 text-sm text-teal-600"><Icon name="pin" class="h-4 w-4" />{p.location}</p>
          <p class="mt-3 text-sm text-muted">{p.scope}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="card">
          <blockquote class="text-sm leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="mt-4 text-sm"><span class="font-semibold text-navy-900">{t.author}</span>, <span class="text-muted">{t.org}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
