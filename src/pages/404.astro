---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section">
    <div class="container-x text-center">
      <p class="font-display text-6xl font-extrabold text-gold-500">404</p>
      <h1 class="mt-4 text-3xl font-bold">This page could not be found</h1>
      <p class="mt-3 text-muted">The page may have moved. Try one of these instead.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-dark">Home</a>
        <a href="/services" class="btn btn-outline">Services</a>
        <a href="/contact" class="btn btn-outline">Contact</a>
      </div>
    </div>
  </section>
</Base>
