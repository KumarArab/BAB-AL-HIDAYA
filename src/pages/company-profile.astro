---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { company, contact, registration, approvals, certifications, insurance, stats, leadership, sectors, projects, values, isSampleData } from '../data/site';
import { services } from '../data/services';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Company Profile | {company.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      @page { size: A4; margin: 14mm; }
      @media print { .sheet { box-shadow: none !important; margin: 0 !important; padding: 0 !important; } .page-break { break-before: page; } }
    </style>
  </head>
  <body class="bg-mist py-8 print:bg-white print:py-0">
    <div class="no-print mx-auto mb-4 flex max-w-4xl items-center justify-between px-4">
      <a href="/" class="text-sm font-medium text-teal-600">← Back to website</a>
      <button onclick="window.print()" class="btn btn-dark">Download / Print PDF</button>
    </div>
    {isSampleData && <p class="no-print mx-auto mb-4 max-w-4xl px-4 text-xs text-muted">Preview: contains sample data.</p>}

    <article class="sheet mx-auto max-w-4xl bg-white p-8 shadow-lg sm:p-12">
      <!-- Cover -->
      <header class="flex items-start justify-between border-b-4 border-gold-500 pb-6">
        <Logo />
        <div class="text-right text-xs text-muted">
          <p class="font-semibold text-navy-900">Company Profile {new Date().getFullYear()}</p>
          <p>{company.domain}</p>
        </div>
      </header>

      <section class="mt-8">
        <h1 class="text-3xl font-extrabold">{company.legalName}</h1>
        <p class="mt-1 text-sm text-muted" dir="rtl">{company.legalNameAr}</p>
        <p class="mt-4 leading-relaxed text-ink">{company.shortPitch} Established in {company.founded}, the company holds a professional trade licence issued by the {registration.issuingAuthority}.</p>
        <div class="mt-6 grid grid-cols-4 gap-3">
          {stats.map((s) => (
            <div class="rounded-lg bg-mist p-3 text-center"><p class="font-display text-2xl font-extrabold text-navy-900">{s.value}</p><p class="text-[11px] text-muted">{s.label}</p></div>
          ))}
        </div>
      </section>

      <section class="mt-8">
        <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">1. Company Registration</h2>
        <table class="mt-3 w-full text-sm">
          <tbody class="divide-y divide-line">
            <tr><td class="w-1/3 py-2 text-muted">Legal form</td><td class="py-2 font-medium">{registration.legalForm}</td></tr>
            <tr><td class="py-2 text-muted">Trade licence no.</td><td class="py-2 font-medium">{registration.tradeLicenceNo} ({registration.licenceType})</td></tr>
            <tr><td class="py-2 text-muted">Issuing authority</td><td class="py-2 font-medium">{registration.issuingAuthority}</td></tr>
            <tr><td class="py-2 text-muted">Validity</td><td class="py-2 font-medium">{registration.licenceIssued} to {registration.licenceExpiry}</td></tr>
            <tr><td class="py-2 text-muted">VAT TRN</td><td class="py-2 font-medium">{registration.vatTrn}</td></tr>
            <tr><td class="py-2 text-muted">Chamber of Commerce</td><td class="py-2 font-medium">{registration.chamberMembership}</td></tr>
            <tr><td class="py-2 text-muted">Registered office</td><td class="py-2 font-medium">{contact.address.line1}, {contact.address.line2}, {contact.address.poBox}, {contact.address.city}, UAE</td></tr>
          </tbody>
        </table>
        <p class="mt-3 text-xs text-muted"><strong class="text-navy-900">Licensed activities:</strong> {registration.registeredActivities.join(' · ')}</p>
      </section>

      <section class="mt-8">
        <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">2. Services</h2>
        <div class="mt-3 grid grid-cols-2 gap-4">
          {services.map((s) => (
            <div class="rounded-lg border border-line p-4">
              <h3 class="text-sm font-bold">{s.title}</h3>
              <p class="mt-1 text-xs text-muted">{s.items.slice(0, 4).join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="page-break mt-8">
        <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">3. Management</h2>
        <div class="mt-3 grid grid-cols-2 gap-4">
          {leadership.map((p) => (
            <div class="rounded-lg border border-line p-4">
              <p class="text-sm font-bold">{p.name}</p>
              <p class="text-xs font-semibold text-teal-600">{p.role}</p>
              <p class="mt-1 text-xs text-muted">{p.bio}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-8 grid grid-cols-2 gap-8">
        <div>
          <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">4. Approvals & Certifications</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {approvals.map((a) => <li><span class="font-medium">{a.title}</span><br /><span class="text-xs text-muted">{a.detail} Ref. {a.ref}</span></li>)}
            {certifications.map((c) => <li><span class="font-medium">{c.code}</span>: <span class="text-muted">{c.name}</span></li>)}
          </ul>
        </div>
        <div>
          <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">5. Insurance</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {insurance.map((i) => <li><span class="font-medium">{i.type}</span><br /><span class="text-xs text-muted">{i.cover}</span></li>)}
          </ul>
        </div>
      </section>

      <section class="mt-8">
        <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">6. Sectors & Selected Engagements</h2>
        <p class="mt-3 text-xs text-muted">{sectors.map((s) => s.title).join(' · ')}</p>
        <table class="mt-3 w-full text-xs">
          <thead><tr class="bg-navy-900 text-left text-white"><th class="p-2">Property</th><th class="p-2">Location</th><th class="p-2">Scope</th><th class="p-2">Period</th></tr></thead>
          <tbody class="divide-y divide-line">
            {projects.map((p) => <tr><td class="p-2 font-medium">{p.title}</td><td class="p-2">{p.location}</td><td class="p-2 text-muted">{p.scope}</td><td class="p-2">{p.duration}</td></tr>)}
          </tbody>
        </table>
      </section>

      <section class="mt-8">
        <h2 class="border-l-4 border-teal-600 pl-3 text-lg font-bold">7. Our Values</h2>
        <div class="mt-3 grid grid-cols-4 gap-3">
          {values.map((v) => <div class="rounded-lg bg-mist p-3"><p class="text-sm font-bold">{v.title}</p><p class="mt-1 text-[11px] text-muted">{v.text}</p></div>)}
        </div>
      </section>

      <footer class="mt-10 flex flex-wrap justify-between gap-4 border-t-4 border-gold-500 pt-4 text-xs text-muted">
        <span>{contact.phone} · {contact.email}</span>
        <span>{company.domain}</span>
        <span>TL {registration.tradeLicenceNo} · TRN {registration.vatTrn}</span>
      </footer>
    </article>
  </body>
</html>
