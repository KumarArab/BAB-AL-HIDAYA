---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { leadership } from '../data/site';

const initials = (name: string) => name.split(' ').filter((_, i, a) => i === 0 || i === a.length - 1).map((p) => p[0]).join('');

const org = [
  { dept: 'Technical Services', lead: 'Operations Manager', teams: 'MEP supervisors · HVAC technicians · Electricians · Plumbers · Civil & painting' },
  { dept: 'Cleaning Services', lead: 'Operations Manager', teams: 'Site supervisors · Cleaning crews · Facade / rope-access team' },
  { dept: 'HSE & Quality', lead: 'HSE & Quality Manager', teams: 'Safety officers · Training coordinator · ISO document control' },
  { dept: 'Finance & Admin', lead: 'Finance & Administration Manager', teams: 'Accounts · HR & PRO · Procurement · Helpdesk' },
];
---
<Base title="Leadership" description="The management team of Bab Al Hidaya Building Maintenance & Cleaning Services L.L.C.">
  <PageHero eyebrow="Leadership" title="The people accountable for your building" subtitle="An experienced management team with backgrounds in facilities, engineering, safety and finance." crumbs={[{ label: 'About', href: '/about' }, { label: 'Leadership' }]} />

  <section class="section">
    <div class="container-x grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {leadership.map((p) => (
        <article class="card">
          <div class="flex h-20 w-20 items-center justify-center rounded-full bg-navy-900 font-display text-2xl font-bold text-gold-400">{initials(p.name)}</div>
          <h2 class="mt-5 text-lg font-bold">{p.name}</h2>
          <p class="text-sm font-semibold text-teal-600">{p.role}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{p.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow="Organisation" title="How we are structured" lead="Every contract has a named account manager, a site supervisor and direct access to management." />
      <div class="mt-10 flex justify-center">
        <div class="rounded-lg bg-navy-900 px-6 py-3 text-center text-white"><p class="text-xs text-white/60">Founder &amp;</p><p class="font-bold">Managing Director</p></div>
      </div>
      <div class="mx-auto h-8 w-px bg-line"></div>
      <div class="grid gap-4 md:grid-cols-4">
        {org.map((o) => (
          <div class="rounded-xl border border-line bg-white p-5">
            <p class="font-bold text-navy-900">{o.dept}</p>
            <p class="text-xs font-semibold text-teal-600">{o.lead}</p>
            <p class="mt-3 text-sm text-muted">{o.teams}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
