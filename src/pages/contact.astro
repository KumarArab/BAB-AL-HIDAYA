---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { contact, whatsappLink } from '../data/site';
import { services } from '../data/services';

const propertyTypes = ['Residential tower', 'Office / commercial', 'Retail', 'Villa / townhouse', 'School', 'Warehouse / industrial', 'Hotel / F&B', 'Other'];
---
<Base title="Contact Us" description="Contact Bab Al Hidaya for building maintenance, AMC and cleaning quotations in Dubai.">
  <PageHero eyebrow="Contact" title="Let’s talk about your property" subtitle="Request a quotation, book a free site survey or ask us anything. We reply within one working day." crumbs={[{ label: 'Contact' }]} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-4">
        <div class="card">
          <h2 class="text-lg font-bold">Office</h2>
          <ul class="mt-4 space-y-4 text-sm">
            <li class="flex gap-3"><Icon name="pin" class="h-5 w-5 shrink-0 text-teal-600" /><span>{contact.address.line1}<br />{contact.address.line2}<br />{contact.address.poBox}, {contact.address.city}<br />{contact.address.country}</span></li>
            <li class="flex gap-3"><Icon name="phone" class="h-5 w-5 shrink-0 text-teal-600" /><a href={contact.phoneHref} class="hover:text-teal-600">{contact.phone}</a></li>
            <li class="flex gap-3"><Icon name="whatsapp" class="h-5 w-5 shrink-0 text-teal-600" /><a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-teal-600">{contact.mobile}</a></li>
            <li class="flex gap-3"><Icon name="mail" class="h-5 w-5 shrink-0 text-teal-600" /><a href={`mailto:${contact.email}`} class="hover:text-teal-600">{contact.email}</a></li>
          </ul>
        </div>
        <div class="card">
          <h2 class="text-lg font-bold">Working hours</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {contact.hours.map((h) => <li class="flex justify-between gap-4"><span class="text-muted">{h.days}</span><span class="text-right font-medium">{h.time}</span></li>)}
          </ul>
          <p class="mt-4 rounded-md bg-gold-50 p-3 text-xs font-medium text-navy-900">{contact.emergency}</p>
        </div>
      </div>

      <div id="quote" class="scroll-mt-28 lg:col-span-8">
        <div class="rounded-2xl border border-line bg-mist p-6 sm:p-10">
          <h2 class="text-2xl font-bold">Request a quotation</h2>
          <p class="mt-2 text-sm text-muted">Fill in the details and send them to us on WhatsApp or by email.</p>
          <form id="quote-form" class="mt-8 grid gap-5 sm:grid-cols-2">
            <label class="label">Full name *<input name="name" required class="field" autocomplete="name" /></label>
            <label class="label">Company<input name="company" class="field" autocomplete="organization" /></label>
            <label class="label">Phone *<input name="phone" required type="tel" class="field" placeholder="+971" autocomplete="tel" /></label>
            <label class="label">Email<input name="email" type="email" class="field" autocomplete="email" /></label>
            <label class="label">Service required *
              <select name="service" required class="field">
                <option value="">Select a service</option>
                {services.map((s) => <option>{s.title}</option>)}
                <option>Multiple / not sure</option>
              </select>
            </label>
            <label class="label">Property type
              <select name="property" class="field">
                <option value="">Select</option>
                {propertyTypes.map((p) => <option>{p}</option>)}
              </select>
            </label>
            <label class="label sm:col-span-2">Location / area<input name="location" class="field" placeholder="e.g. JLT, Business Bay, Al Nahda Sharjah" /></label>
            <label class="label sm:col-span-2">Details<textarea name="message" rows="4" class="field" placeholder="Size of property, number of units, current issues, preferred start date…"></textarea></label>
            <div class="flex flex-wrap gap-3 sm:col-span-2">
              <button type="submit" data-channel="whatsapp" class="btn btn-dark"><Icon name="whatsapp" class="h-4 w-4" /> Send via WhatsApp</button>
              <button type="submit" data-channel="email" class="btn btn-outline"><Icon name="mail" class="h-4 w-4" /> Send via Email</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="no-print">
    <iframe title="Office location map" src={contact.mapEmbed} class="h-80 w-full border-0 grayscale" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Base>

<script define:vars={{ wa: contact.whatsapp, email: contact.email }}>
  const form = document.getElementById('quote-form');
  let channel = 'whatsapp';
  form.querySelectorAll('button[data-channel]').forEach((b) =>
    b.addEventListener('click', () => (channel = b.dataset.channel)));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const labels = { name: 'Name', company: 'Company', phone: 'Phone', email: 'Email', service: 'Service', property: 'Property type', location: 'Location', message: 'Details' };
    const lines = Object.entries(labels).map(([k, l]) => (d.get(k) ? `${l}: ${d.get(k)}` : null)).filter(Boolean);
    const body = `Quotation request\n\n${lines.join('\n')}`;
    if (channel === 'email') {
      location.href = `mailto:${email}?subject=${encodeURIComponent('Quotation request: ' + d.get('service'))}&body=${encodeURIComponent(body)}`;
    } else {
      window.open(`https://wa.me/${wa}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
    }
  });
</script>
