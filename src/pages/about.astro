---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, stats, values } from '../data/site';

const milestones = [
  { year: '2019', text: 'Company incorporated in Dubai as an L.L.C and trade licence issued by DET.' },
  { year: '2020', text: 'Dubai Municipality approval for water tank cleaning and disinfection.' },
  { year: '2021', text: 'First high-rise residential AMC signed. Team grows to 40 staff.' },
  { year: '2022', text: 'ISO 9001, 14001 and 45001 certification achieved.' },
  { year: '2024', text: 'Operations extended to Sharjah and Ajman. Workforce passes 100.' },
  { year: '2026', text: '85+ active annual maintenance contracts across the Northern Emirates.' },
];
---
<Base title="About Us" description={`About ${company.legalName}: a licensed Dubai building maintenance and cleaning company.`}>
  <PageHero eyebrow="About us" title="A Dubai company built on doing the basics right" subtitle="Clean buildings, working systems and honest service, since 2019." crumbs={[{ label: 'About' }]} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHead eyebrow="Who we are" title="Your building’s long-term care partner" />
        <div class="mt-6 space-y-4 leading-relaxed text-muted">
          <p><strong class="text-navy-900">{company.legalName}</strong> is a limited liability company licensed by the Department of Economy and Tourism, Dubai, to provide building maintenance and cleaning services.</p>
          <p>We started with a small team of technicians and cleaners serving residential buildings in Al Qusais. Today we look after towers, offices, retail outlets, schools and villa communities across Dubai, Sharjah and Ajman.</p>
          <p>We employ our own trained staff, run documented safety and quality systems, and hold the licences, approvals and insurance our clients need to work with us with confidence.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 self-start">
        {stats.map((s) => (
          <div class="rounded-xl bg-mist p-6">
            <p class="font-display text-4xl font-extrabold text-navy-900">{s.value}</p>
            <p class="mt-1 text-sm text-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-2">
      <div class="card p-8">
        <span class="icon-tile"><Icon name="star" /></span>
        <h3 class="mt-5 text-xl font-bold">Our Vision</h3>
        <p class="mt-3 text-muted">To be the most trusted mid-sized building maintenance and cleaning company in the UAE, known for reliability, safety and integrity.</p>
      </div>
      <div class="card p-8">
        <span class="icon-tile"><Icon name="check" /></span>
        <h3 class="mt-5 text-xl font-bold">Our Mission</h3>
        <p class="mt-3 text-muted">To protect the value of our clients’ properties through planned maintenance, professional cleaning and transparent service, delivered by well-trained and well-treated people.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Our values" title="What we stand for" center />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-xl border-t-4 border-gold-500 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold">{v.title}</h3>
            <p class="mt-2 text-sm text-muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow="Our journey" title="Milestones" />
      <ol class="relative mt-12 border-l-2 border-line pl-8">
        {milestones.map((m) => (
          <li class="relative mb-10 last:mb-0">
            <span class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-4 border-mist bg-teal-600"></span>
            <p class="font-display text-lg font-extrabold text-gold-500">{m.year}</p>
            <p class="mt-1 text-muted">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CtaBand />
</Base>
