---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, stats, registration, approvals, certifications, sectors, testimonials, whatsappLink } from '../data/site';
import { services } from '../data/services';

const reasons = [
  { icon: 'shield', title: 'Fully licensed & insured', text: 'DET-licensed L.L.C with Dubai Municipality approvals and AED 2M liability cover.' },
  { icon: 'clock', title: 'Committed response times', text: '2-hour emergency response for AMC clients, written into every contract.' },
  { icon: 'users', title: 'In-house, trained teams', text: 'Our own technicians and cleaners, not subcontractors. Uniformed, supervised and certified.' },
  { icon: 'doc', title: 'Transparent reporting', text: 'Photo job reports and monthly service summaries for owners and managers.' },
] as const;

const steps = [
  { n: '01', title: 'Free site survey', text: 'We inspect your property and build an asset register.' },
  { n: '02', title: 'Tailored proposal', text: 'A clear scope, PPM schedule, SLA and fixed annual price.' },
  { n: '03', title: 'Mobilisation', text: 'Dedicated account manager, team induction and a helpdesk line.' },
  { n: '04', title: 'Report & improve', text: 'Monthly reports, quarterly reviews and continuous improvement.' },
];
---
<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div class="pattern-grid absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -left-32 top-10 h-96 w-96 rounded-full bg-teal-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -right-20 bottom-0 h-80 w-80 rounded-full bg-gold-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="container-x relative grid items-center gap-12 py-20 lg:grid-cols-12 lg:py-28">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium text-white/80">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span> Licensed in Dubai since {company.founded}
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.1] text-white sm:text-5xl lg:text-6xl">
          Building maintenance &amp; cleaning, <span class="text-gold-400">done properly.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/75">{company.shortPitch}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact#quote" class="btn btn-primary">Request a Free Site Survey <Icon name="arrow" class="h-4 w-4" /></a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="whatsapp" class="h-4 w-4" /> Chat on WhatsApp</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-teal-500" />ISO 9001 · 14001 · 45001</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-teal-500" />Dubai Municipality approved</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-teal-500" />24/7 emergency line</li>
        </ul>
      </div>

      <!-- Company credentials card -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl backdrop-blur sm:p-8">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">Company credentials</p>
            <Icon name="shield" class="h-6 w-6 text-teal-500" />
          </div>
          <dl class="mt-6 divide-y divide-white/10 text-sm">
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">Legal form</dt><dd class="text-right font-medium">L.L.C, Dubai</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">Trade licence</dt><dd class="text-right font-medium">No. {registration.tradeLicenceNo}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">Issued by</dt><dd class="text-right font-medium">DET, Government of Dubai</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">VAT TRN</dt><dd class="text-right font-medium">{registration.vatTrn}</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-white/60">Approvals</dt><dd class="text-right font-medium">DM · Civil Defence</dd></div>
          </dl>
          <a href="/licences" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-400 hover:text-gold-50">View licences &amp; compliance <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-b border-line bg-white">
    <div class="container-x grid grid-cols-2 divide-line py-10 md:grid-cols-4 md:divide-x">
      {stats.map((s) => (
        <div class="px-4 py-4 text-center">
          <p class="font-display text-4xl font-extrabold text-navy-900">{s.value}</p>
          <p class="mt-1 text-sm text-muted">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-mist">
    <div class="container-x">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHead eyebrow="What we do" title="Maintenance and cleaning under one contract" lead="One accountable partner for the technical upkeep and cleanliness of your building." />
        <a href="/services" class="btn btn-outline shrink-0">All services</a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="card group flex flex-col">
            <span class="icon-tile"><Icon name={s.icon} /></span>
            <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{s.summary}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-teal-600">Learn more <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <SectionHead eyebrow="Why Bab Al Hidaya" title="A small company, run to big-company standards" lead="We combine the attention of a local firm with the licensing, insurance, safety systems and reporting that property managers and corporate clients expect." />
      <div class="grid gap-6 sm:grid-cols-2">
        {reasons.map((r) => (
          <div>
            <span class="icon-tile"><Icon name={r.icon} /></span>
            <h3 class="mt-4 font-bold">{r.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AMC PROCESS -->
  <section class="section bg-navy-900 text-white">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">Annual Maintenance Contracts</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">How an AMC with us works</h2>
        <p class="mt-4 text-lg text-white/70">Predictable costs, planned maintenance and a response time you can hold us to.</p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-4">
        {steps.map((s) => (
          <li class="rounded-xl border border-white/10 bg-white/[0.03] p-6">
            <span class="font-display text-3xl font-extrabold text-gold-400">{s.n}</span>
            <h3 class="mt-3 font-bold text-white">{s.title}</h3>
            <p class="mt-2 text-sm text-white/65">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 grid gap-4 rounded-xl bg-white/5 p-6 sm:grid-cols-3">
        <div><p class="text-sm text-white/60">Emergency</p><p class="font-display text-2xl font-bold text-white">2 hours on-site</p></div>
        <div><p class="text-sm text-white/60">Urgent</p><p class="font-display text-2xl font-bold text-white">Same day</p></div>
        <div><p class="text-sm text-white/60">Routine</p><p class="font-display text-2xl font-bold text-white">Within 48 hours</p></div>
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Sectors" title="Properties we look after" center />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {sectors.map((s) => (
          <div class="rounded-xl border border-line p-5">
            <h3 class="font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPLIANCE STRIP -->
  <section class="section bg-mist">
    <div class="container-x">
      <SectionHead eyebrow="Compliance" title="Licensed, certified and insured" lead="Documentation available on request for tenders, vendor registration and due diligence." center />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {certifications.map((c) => (
          <div class="card text-center">
            <p class="font-display text-xl font-extrabold text-navy-900">{c.code}</p>
            <p class="mt-1 text-sm text-muted">{c.name}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {approvals.map((a) => (
          <div class="flex gap-3 rounded-xl border border-line bg-white p-5">
            <Icon name="shield" class="h-6 w-6 shrink-0 text-teal-600" />
            <div><p class="text-sm font-bold text-navy-900">{a.title}</p><p class="mt-1 text-xs text-muted">{a.detail}</p></div>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center"><a href="/licences" class="btn btn-dark">Licences &amp; Compliance</a></div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Client feedback" title="What our clients say" center />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <figure class="card flex flex-col">
            <div class="flex gap-0.5 text-gold-500">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-4 w-4 fill-current" />)}</div>
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-ink">“{t.quote}”</blockquote>
            <figcaption class="mt-5 border-t border-line pt-4 text-sm"><span class="font-semibold text-navy-900">{t.author}</span><br /><span class="text-muted">{t.org}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
