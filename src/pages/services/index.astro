---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
---
<Base title="Services" description="Building maintenance, AMC contracts, HVAC, commercial cleaning, facade cleaning and water tank disinfection in Dubai.">
  <PageHero eyebrow="Our services" title="Everything your building needs, from one licensed partner" subtitle="Technical maintenance and professional cleaning, available as one-off jobs or as a single annual contract." crumbs={[{ label: 'Services' }]} />

  <section class="section">
    <div class="container-x space-y-6">
      {services.map((s, i) => (
        <article class="card grid gap-8 p-8 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <div class="flex items-center gap-4">
              <span class="icon-tile"><Icon name={s.icon} /></span>
              <span class="font-display text-sm font-bold text-gold-500">0{i + 1}</span>
            </div>
            <h2 class="mt-5 text-2xl font-bold">{s.title}</h2>
            <p class="mt-3 text-muted">{s.intro}</p>
            <a href={`/services/${s.slug}`} class="btn btn-outline mt-6">View details <Icon name="arrow" class="h-4 w-4" /></a>
          </div>
          <ul class="grid content-start gap-3 sm:grid-cols-2 lg:col-span-7">
            {s.items.map((item) => (
              <li class="flex gap-2 text-sm"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
