---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { contact, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug);
---
<Base title={service.title} description={service.summary}>
  <PageHero eyebrow="Service" title={service.title} subtitle={service.summary} crumbs={[{ label: 'Services', href: '/services' }, { label: service.title }]} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="text-lg leading-relaxed text-ink">{service.intro}</p>
        <h2 class="mt-10 text-2xl font-bold">What’s included</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {service.items.map((item) => (
            <li class="flex gap-3 rounded-lg border border-line p-4 text-sm"><Icon name="check" class="h-5 w-5 shrink-0 text-teal-600" />{item}</li>
          ))}
        </ul>
        <h2 class="mt-10 text-2xl font-bold">Why clients choose us</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {service.benefits.map((b) => (
            <li class="rounded-lg bg-teal-50 p-4 text-sm font-semibold text-navy-900">{b}</li>
          ))}
        </ul>
      </div>

      <aside class="space-y-6 lg:col-span-4">
        <div class="rounded-xl bg-navy-900 p-6 text-white">
          <h3 class="text-lg font-bold text-white">Get a quotation</h3>
          <p class="mt-2 text-sm text-white/70">Tell us about your property. We reply within one working day.</p>
          <a href="/contact#quote" class="btn btn-primary mt-5 w-full">Request a Quote</a>
          <a href={whatsappLink(`Hello, I would like a quotation for ${service.title}.`)} target="_blank" rel="noopener" class="btn btn-ghost mt-3 w-full"><Icon name="whatsapp" class="h-4 w-4" /> WhatsApp</a>
          <a href={contact.phoneHref} class="mt-4 flex items-center justify-center gap-2 text-sm text-white/70 hover:text-white"><Icon name="phone" class="h-4 w-4" />{contact.phone}</a>
        </div>
        <div class="rounded-xl border border-line p-6">
          <h3 class="font-bold">Other services</h3>
          <ul class="mt-4 space-y-2 text-sm">
            {others.map((s) => <li><a href={`/services/${s.slug}`} class="flex items-center justify-between text-muted hover:text-teal-600">{s.title}<Icon name="arrow" class="h-4 w-4" /></a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <CtaBand />
</Base>
