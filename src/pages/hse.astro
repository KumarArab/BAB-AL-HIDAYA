---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { certifications } from '../data/site';

const pillars = [
  { icon: 'hardhat', title: 'Health & Safety', points: ['Risk assessment and method statement for every job', 'Permit-to-work for height, electrical and confined spaces', 'PPE issued and inspected for all staff', 'Toolbox talks before every shift'] },
  { icon: 'star', title: 'Quality', points: ['Supervisor inspection checklists', 'Photo-documented job completion', 'Monthly client service reports', 'Quarterly client satisfaction reviews'] },
  { icon: 'leaf', title: 'Environment', points: ['Eco-certified, biodegradable cleaning chemicals', 'Water-saving cleaning equipment', 'Segregation and licensed disposal of waste', 'Energy-efficiency recommendations in AMCs'] },
  { icon: 'users', title: 'People & Welfare', points: ['Induction and trade training for all new staff', 'Heat-stress programme and midday break compliance', 'Company-provided accommodation and transport', 'Salaries paid on time through WPS'] },
] as const;

const kpis = [
  { value: '0', label: 'Lost-time injuries (last 12 months)' },
  { value: '1.2M', label: 'Safe man-hours' },
  { value: '100%', label: 'Staff with safety induction' },
  { value: '96%', label: 'Client satisfaction score' },
];
---
<Base title="HSE & Quality" description="Health, safety, environment and quality management at Bab Al Hidaya.">
  <PageHero eyebrow="HSE & quality" title="Safety first, quality always" subtitle="Documented systems certified to ISO 9001, ISO 14001 and ISO 45001." crumbs={[{ label: 'About', href: '/about' }, { label: 'HSE & Quality' }]} />

  <section class="border-b border-line">
    <div class="container-x grid grid-cols-2 py-10 md:grid-cols-4">
      {kpis.map((k) => (
        <div class="p-4 text-center"><p class="font-display text-4xl font-extrabold text-teal-600">{k.value}</p><p class="mt-1 text-sm text-muted">{k.label}</p></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead eyebrow="Our commitment" title="HSE & quality policy" lead="Management is committed to preventing injury and ill health, protecting the environment, complying with all UAE legal requirements, and continually improving the quality of our services." />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {pillars.map((p) => (
          <div class="card p-8">
            <span class="icon-tile"><Icon name={p.icon} /></span>
            <h3 class="mt-5 text-xl font-bold">{p.title}</h3>
            <ul class="mt-4 space-y-2">
              {p.points.map((pt) => <li class="flex gap-2 text-sm text-muted"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{pt}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {certifications.map((c) => (
        <div class="card text-center"><p class="font-display text-xl font-extrabold">{c.code}</p><p class="mt-1 text-sm text-muted">{c.name}</p></div>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
